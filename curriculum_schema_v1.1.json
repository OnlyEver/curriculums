{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Only Ever Curriculum Schema",
  "version": "1.1",
  "description": "Schema for test prep curricula: course > curriculum (sections) > topics > sources (videos only)",

  "type": "object",
  "required": ["schema_version", "course", "curriculum"],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version, e.g. '1.0'"
    },
    
    "course": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string", "description": "Path to hero image" },
        "test_code": { "type": "string" },
        "provider": { "type": "string" },
        "category": { "type": "string" },
        "duration_minutes": { "type": "integer" },
        "total_questions": { "type": "integer" }
      }
    },
    
    "curriculum": {
      "type": "array",
      "description": "Array of sections, each containing topics with video sources",
      "items": {
        "type": "object",
        "required": ["id", "title", "topics"],
        "properties": {
          "id": { 
            "type": "string",
            "description": "Section ID, e.g. 'section_0', 'section_1'"
          },
          "title": { "type": "string" },
          "weight_percent": { 
            "type": "number",
            "description": "Percentage of test questions from this section (0-100)"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "sources"],
              "properties": {
                "id": { 
                  "type": "string",
                  "description": "Topic ID, e.g. '1.1', '1.2'"
                },
                "title": { "type": "string" },
                "sources": {
                  "type": "array",
                  "description": "Video sources only",
                  "items": {
                    "type": "object",
                    "required": ["title", "url", "type"],
                    "properties": {
                      "title": { "type": "string" },
                      "url": { 
                        "type": "string", 
                        "format": "uri",
                        "pattern": "^https://(www\\.)?youtube\\.com/(watch\\?v=|live/)"
                      },
                      "type": { 
                        "type": "string", 
                        "const": "video"
                      },
                      "note": {
                        "type": "string",
                        "description": "Optional note about the video content"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    
    "notes": {
      "type": "object",
      "description": "Optional metadata about the curriculum",
      "additionalProperties": { "type": "string" }
    }
  }